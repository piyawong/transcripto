# Copy to .env (project root). The API also reads .env.test here, which is where bench/ keeps the keys.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
# DATABASE_URL=postgres://transcripto:transcripto@localhost:5440/transcripto
# MinIO (docker compose service "minio"); the same values are used by the API as S3 credentials
# MINIO_ROOT_USER=transcripto
# MINIO_ROOT_PASSWORD=                         # dev default in docker-compose.yml; set a long random value in production
# S3_ENDPOINT=http://127.0.0.1:9010
# S3_BUCKET=transcripto-media
# S3_ACCESS_KEY=transcripto
# S3_SECRET_KEY=                                # same as MINIO_ROOT_PASSWORD
# WORK_DIR=/tmp/transcripto-work    # scratch files while a job is processed (deleted afterwards)
# CORRECT_MODEL=gemini-3.1-pro-preview   # or gemini-3.8-flash
# SUMMARY_MODEL=gemini-3.1-pro-preview
# KEYTERMS_FILE=api/keyterms.txt     # default keyterms for users who haven't set their own (Settings page); no person names
# WORKERS=2
# COOKIE_SECURE=false         # true behind HTTPS
ADMIN_PASSWORD=                      # password of admin@transcripto.app; required when the account is first created (e2e reads it too)
# POSTGRES_PASSWORD=transcripto     # docker compose: applied when the database volume is first created
# DB_PORT=127.0.0.1:5440            # docker compose: host binding of Postgres
# WEB_PORT=3010                     # docker compose: host binding of the web app, e.g. 127.0.0.1:3011 behind nginx
# AI_FIXTURE_DIR=../docs/rust-implementation/fixtures   # test mode: replay saved responses, no API calls
